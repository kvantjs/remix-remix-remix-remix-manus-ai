# Runtime
NODE_ENV=production
PORT=3000
RUNTIME_DISTRIBUTION=Ubuntu 24.04
CLOUD_PROVIDER=aws-ec2

# AI/provider secrets are injected only through the deployment secret manager.
GEMINI_API_KEY=

# Sandbox backend: local-isolated (default) or ssm (AWS Systems Manager)
AWS_SANDBOX_MODE=local
AWS_REGION=us-east-1
AWS_SSM_INSTANCE_ID=
AWS_SANDBOX_WORKSPACE=/opt/kvant/workspace

# Browser policy: stop and request authorized human handoff on challenges.
BROWSER_CHALLENGE_POLICY=stop_and_request_handoff
BROWSER_HEADLESS=true
